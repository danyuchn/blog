---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import DiagnosisCta from "@/components/DiagnosisCta.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { findTranslation } from "@/utils/i18n";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { getLangFromPost } from "@/utils/i18n";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  archived,
} = post.data;

const { Content, headings } = await render(post);

/* 浮動目錄：只收 H2，少於 2 條不顯示（短敘事文無標題層級） */
const tocHeadings = headings.filter(h => h.depth === 2);
const showToc = tocHeadings.length >= 2;
const tocLabel = getLangFromPost(post) === "zh" ? "目錄" : "On this page";

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const postLang = getLangFromPost(post);
/** Deep posts (raw markdown body >= 6000 characters) also link the 1-on-1 program. */
const DEEP_POST_CHARS = 6000;
const isDeep = (post.body?.length ?? 0) >= DEEP_POST_CHARS;
const translation = findTranslation(post, posts);
const translationUrl = translation
  ? getPath(translation.id, translation.filePath)
  : undefined;

/* hreflang alternates: only when a published translation exists.
   Absolute URLs on SITE.website, trailing slash (same form as canonical). */
const absoluteUrl = (path: string) => {
  const url = new URL(path, SITE.website);
  if (!url.pathname.endsWith("/")) url.pathname += "/";
  return url.href;
};
const alternates = (() => {
  if (!translation || !translationUrl) return [];
  const selfHref = absoluteUrl(getPath(post.id, post.filePath));
  const transHref = absoluteUrl(translationUrl);
  const zhHref = postLang === "zh" ? selfHref : transHref;
  const enHref = postLang === "en" ? selfHref : transHref;
  return [
    { hreflang: "zh-Hant", href: zhHref },
    { hreflang: "en", href: enHref },
    { hreflang: "x-default", href: zhHref },
  ];
})();

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  language: postLang,
  alternates,
};

/* ========== Prev/Next Posts (same language only) ========== */

const sameLangPosts = posts
  .filter(p => !p.data.archived || p.id === post.id)
  .filter(p => getLangFromPost(p) === postLang)
  .map(({ data: { title }, id, filePath }) => ({
    id,
    title,
    filePath,
  }));

const currentPostIndex = sameLangPosts.findIndex(a => a.id === post.id);

const prevPost =
  currentPostIndex > 0 ? sameLangPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex < sameLangPosts.length - 1
    ? sameLangPosts[currentPostIndex + 1]
    : null;

/* ========== Related reading: same language, ranked by shared tags then recency ========== */

const RELATED_COUNT = 3;
const currentTags = new Set(tags ?? []);
const relatedPosts = posts
  .map((p, recencyRank) => ({
    p,
    recencyRank, // `posts` is already sorted newest first
    shared: p.data.tags.filter(tag => currentTags.has(tag)).length,
  }))
  .filter(
    ({ p }) =>
      p.id !== post.id &&
      p.id !== translation?.id &&
      !p.data.archived &&
      getLangFromPost(p) === postLang
  )
  .sort((a, b) => b.shared - a.shared || a.recencyRank - b.recencyRank)
  .slice(0, RELATED_COUNT)
  .map(({ p }) => p);
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body={archived ? undefined : ""}
    data-translation-url={translationUrl}
    data-post-slug={post.id}
  >
    {
      archived && (
        <p class="mb-6 border-l-4 border-accent pl-3 text-sm opacity-80">
          {postLang === "zh"
            ? "這篇文章已封存：內容可能過時，保留原網址供參考。"
            : "This post is archived: it may be out of date and is kept for reference."}
        </p>
      )
    }
    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm tracking-wide"
    >
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="mt-4 font-display text-3xl leading-tight font-black text-foreground sm:text-4xl"
    >
      {title}
    </h1>
    {
      tags && tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="tags">
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }
    {
      description && (
        <p class="mt-6 border-y border-border py-4 text-base leading-relaxed text-foreground/75 sm:text-lg">
          {description}
        </p>
      )
    }
    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      {
        showToc && (
          <>
            <aside
              class="not-prose float-right mb-4 ml-8 hidden w-56 border border-border p-4 sm:block"
              aria-label={tocLabel}
              data-pagefind-ignore
            >
              <p class="text-xs font-semibold tracking-widest text-foreground/60 uppercase">
                {tocLabel}
              </p>
              <ol class="mt-2 flex list-none flex-col gap-1.5 text-sm">
                {tocHeadings.map(h => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="text-foreground/80 no-underline transition-colors duration-150 hover:text-accent"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </aside>
            {/* !-modifiers: `.app-prose details` (inline-block) outranks plain
                display utilities, which made this TOC show on desktop too. */}
            <details
              class="not-prose mb-6 block! w-full border border-border p-4 sm:hidden!"
              data-pagefind-ignore
            >
              <summary class="text-xs font-semibold tracking-widest text-foreground/60 uppercase">
                {tocLabel}
              </summary>
              <ol class="mt-2 flex list-none flex-col gap-1.5 text-sm">
                {tocHeadings.map(h => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="text-foreground/80 no-underline transition-colors duration-150 hover:text-accent"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </>
        )
      }
      <Content />
    </article>

    <hr class="my-8" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <DiagnosisCta lang={postLang} slug={post.id} deep={isDeep} />

    {
      relatedPosts.length > 0 && (
        <section class="mt-10" aria-labelledby="related-heading" data-pagefind-ignore>
          <h2
            id="related-heading"
            class="border-b-2 border-foreground pb-2 font-display text-xl font-bold text-foreground"
          >
            {t("post.related", postLang)}
          </h2>
          <ul class="list-none">
            {relatedPosts.map(rp => (
              <li class="border-b border-border py-4">
                <Datetime
                  pubDatetime={rp.data.pubDatetime}
                  modDatetime={rp.data.modDatetime}
                  timezone={rp.data.timezone}
                  class="text-sm text-foreground/60"
                />
                <a
                  href={getPath(rp.id, rp.filePath)}
                  class="mt-1 block font-display text-lg leading-snug font-bold text-foreground transition-colors duration-150 hover:text-accent focus-visible:ring-1 focus-visible:ring-accent focus-visible:outline-none"
                >
                  {rp.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <ShareLinks />

    <!-- Previous/Next Post Buttons -->
    <div
      data-pagefind-ignore
      class="mt-6 grid grid-cols-1 border-t-2 border-foreground sm:grid-cols-2"
    >
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="group block p-4 transition-colors duration-200 hover:bg-accent-surface"
          >
            <span class="text-xs tracking-widest text-foreground/60 uppercase">
              Previous Post
            </span>
            <div class="mt-1 font-display text-sm font-bold transition-colors duration-150 group-hover:text-accent">
              {prevPost.title}
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class:list={[
              "group block p-4 text-end transition-colors duration-200 hover:bg-accent-surface sm:col-start-2",
              { "border-t border-border sm:border-s sm:border-t-0": prevPost },
            ]}
          >
            <span class="text-xs tracking-widest text-foreground/60 uppercase">
              Next Post
            </span>
            <div class="mt-1 font-display text-sm font-bold transition-colors duration-150 group-hover:text-accent">
              {nextPost.title}
            </div>
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  /* GA4 custom events (gtag is loaded in Layout.astro). One delegated listener
     on document, registered once, so it survives ClientRouter navigations. */
  type Gtag = (command: "event", name: string, params: object) => void;

  function sendEvent(name: string, params: Record<string, string>) {
    const gtag = (window as unknown as { gtag?: Gtag }).gtag;
    if (typeof gtag !== "function") return;
    gtag("event", name, params);
  }

  document.addEventListener("click", e => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    const postSlug =
      document.querySelector<HTMLElement>("[data-post-slug]")?.dataset
        .postSlug ?? "";

    const copyButton = target.closest("button.copy-code");
    if (copyButton) {
      sendEvent("prompt_copy", { post_slug: postSlug });
      return;
    }

    const link = target.closest<HTMLAnchorElement>("a[href]");
    if (!link) return;
    let ctaLocation: string | undefined;
    if (link.closest("[data-cta-location='post_end']")) {
      ctaLocation = "post_end";
    } else if (link.closest(".post-inline-cta")) {
      ctaLocation = "post_inline";
    }
    if (!ctaLocation) return;
    sendEvent("blog_cta_click", {
      cta_location: ctaLocation,
      link_url: link.href,
      post_slug: postSlug,
    });
  });
</script>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
