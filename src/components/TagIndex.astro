---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import { displayTag } from "@/i18n/tags";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";
import getUniqueTags from "@/utils/getUniqueTags";
import { filterByLang, type Lang } from "@/utils/i18n";
import postFilter from "@/utils/postFilter";
import { hreflangAlternates, tagsPath, tagPagePath } from "@/utils/siteLang";
import { slugifyStr } from "@/utils/slugify";
import { withBase } from "@/utils/withBase";

type Props = { lang: Lang };

const { lang } = Astro.props;
const other: Lang = lang === "zh" ? "en" : "zh";
const posts = filterByLang(await getCollection("blog"), lang).filter(
  post => postFilter(post) && !post.data.archived
);
const tags = getUniqueTags(posts);
const countFor = (tagSlug: string) =>
  posts.filter(post =>
    (post.data.tags ?? []).some(tag => slugifyStr(tag) === tagSlug)
  ).length;
---

<Layout
  title={`${t("tags.title", lang)} | ${SITE.title}`}
  description={t("tags.desc", lang)}
  language={lang}
  siteLang={lang}
  langAlt={withBase(tagsPath(other))}
  alternates={hreflangAlternates(tagsPath("zh"), tagsPath("en"))}
>
  <Header />
  <Main pageTitle={t("tags.title", lang)} pageDesc={t("tags.desc", lang)}>
    <ul class="grid grid-cols-2 border-s border-t border-border sm:grid-cols-3">
      {
        tags.map(({ tag }) => (
          <li class="border-e border-b border-border">
            <a
              href={withBase(tagPagePath(lang, tag))}
              transition:name={`${lang}-${tag}`}
              class="group flex h-full flex-col gap-1 p-4 transition-colors duration-200 hover:bg-accent-surface focus-visible:bg-accent-surface"
            >
              <span class="text-xs font-semibold tracking-wide break-all">
                {displayTag(tag, lang)}
              </span>
              <span class="font-display text-2xl leading-none font-black text-foreground transition-colors duration-150 group-hover:text-accent">
                {countFor(tag)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
