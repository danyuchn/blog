---
// On language-split pages (data-site-lang), navigate to the counterpart URL.
// Elsewhere, keep the localStorage toggle, and follow a post translation when one exists.
---

<button
  id="lang-btn"
  class="relative px-2 py-1 text-sm font-medium tracking-widest uppercase hover:text-accent"
  aria-label="Switch language"
>
  <span id="lang-label"></span>
</button>

<script>
  function initLangSwitcher() {
    const btn = document.getElementById("lang-btn");
    const label = document.getElementById("lang-label");
    if (!btn || !label) return;

    const siteLang = document.documentElement.dataset.siteLang;
    const langAlt = document.documentElement.dataset.langAlt;

    if (siteLang === "zh" || siteLang === "en") {
      localStorage.setItem("lang", siteLang);
      label.textContent = siteLang === "zh" ? "EN" : "中文";
      filterByLang(siteLang);
      btn.onclick = () => {
        if (!langAlt) return;
        localStorage.setItem("lang", siteLang === "zh" ? "en" : "zh");
        window.location.href = langAlt;
      };
      return;
    }

    const current = localStorage.getItem("lang") || "zh";
    label.textContent = current === "zh" ? "EN" : "中文";
    filterByLang(current);

    btn.onclick = () => {
      const lang = localStorage.getItem("lang") || "zh";
      const next = lang === "zh" ? "en" : "zh";
      localStorage.setItem("lang", next);
      window.dispatchEvent(new CustomEvent("lang-change", { detail: next }));

      const mainEl = document.getElementById("main-content");
      const translationUrl = mainEl?.dataset.translationUrl;
      if (translationUrl) {
        window.location.href = translationUrl;
        return;
      }

      label.textContent = next === "zh" ? "EN" : "中文";
      filterByLang(next);
    };
  }

  function filterByLang(lang: string) {
    document.querySelectorAll<HTMLElement>("[data-lang]").forEach(el => {
      el.style.display = el.dataset.lang === lang ? "" : "none";
    });

    document.querySelectorAll<HTMLElement>("[data-tag-lang]").forEach(el => {
      el.style.display =
        el.dataset.tagLang === lang || el.dataset.tagLang === "both" ? "" : "none";
    });
  }

  initLangSwitcher();
  document.addEventListener("astro:after-swap", initLangSwitcher);
</script>
