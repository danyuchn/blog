---
import { displayTag } from "@/i18n/tags";
import { langFromPathname, tagPagePath } from "@/utils/siteLang";
import { withBase } from "@/utils/withBase";
import { listedTagSet } from "@/utils/listedTags";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, size = "lg" } = Astro.props;
const lang = langFromPathname(Astro.url.pathname);
const label = displayTag(tag, lang);
// Tags used only by archived posts have no tag page; render them unlinked
const hasPage = (await listedTagSet(lang)).has(tag);
const cls = [
  "inline-block border border-foreground/40 tracking-wide",
  { "hover:border-accent hover:text-accent focus-visible:text-accent": hasPage },
  { "px-2 py-0.5 text-xs": size === "sm" },
  { "px-2.5 py-1 text-sm": size === "lg" },
];
---

<li>
  {
    hasPage ? (
      <a href={withBase(tagPagePath(lang, tag))} transition:name={tag} class:list={cls}>
        {label}
      </a>
    ) : (
      <span class:list={cls}>{label}</span>
    )
  }
</li>
