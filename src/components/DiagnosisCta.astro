---
import { t } from "@/i18n/ui";
import type { Lang } from "@/utils/i18n";

type Props = {
  lang: Lang;
  slug: string;
  /** True when the raw post body is long enough for the 1-on-1 program link. */
  deep?: boolean;
};

const { lang, slug, deep = false } = Astro.props;

const utmContent = slug.replace(/^(zh|en)\//, "");

function ctaHref(path: string, campaign: string) {
  const params = new URLSearchParams({
    utm_source: "blog",
    utm_medium: "post_end",
    utm_campaign: campaign,
    utm_content: utmContent,
  });
  return `https://www.agentcrew.cc${path}?${params.toString()}`;
}

const l0Url = ctaHref("/l0/", "l0");
const l1Url = ctaHref("/l1/", "l1");
const diagnosisUrl = ctaHref("/l3/inquire", "diagnosis");
const soloUrl = ctaHref("/l3/solo", "l3");
---

<div
  class="mt-10 border-2 border-accent bg-accent-surface p-6 sm:p-8"
  data-pagefind-ignore
  data-cta-location="post_end"
>
  <div class="flex items-baseline gap-2">
    <span
      class="font-mono text-xs tracking-widest text-accent uppercase"
      aria-hidden="true"
    >
      &rarr;
    </span>
    <h2 class="font-display text-xl font-bold text-foreground sm:text-2xl">
      {t("l0.title", lang)}
    </h2>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-foreground/75 sm:text-base">
    {t("l0.desc", lang)}
  </p>
  <a
    href={l0Url}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-5 inline-flex items-center gap-1.5 bg-accent px-5 py-3 text-sm font-semibold text-background no-underline"
  >
    {t("l0.cta", lang)}
    <span aria-hidden="true">&rarr;</span>
  </a>
  <p class="mt-4 flex flex-col gap-1.5 text-sm text-foreground/75">
    <a
      href={l1Url}
      target="_blank"
      rel="noopener noreferrer"
      class="link-underline-slide w-fit text-accent"
    >
      {t("l1.link", lang)}
    </a>
    <a
      href={diagnosisUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="link-underline-slide w-fit text-accent"
    >
      {t("diagnosis.cta", lang)}
    </a>
    {
      deep && (
        <a
          href={soloUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline-slide w-fit text-accent"
        >
          {t("l3.link", lang)}
        </a>
      )
    }
  </p>
</div>
