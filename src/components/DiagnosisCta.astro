---
import { t } from "@/i18n/ui";
import type { Lang } from "@/utils/i18n";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;

const ctaUrl =
  "https://agentcrew.cc/l3/inquire?utm_source=blog&utm_medium=post_cta&utm_campaign=diagnosis";
---

<div class="mt-10 border border-border p-6 sm:p-8" data-pagefind-ignore>
  <div class="flex items-baseline gap-2">
    <span
      class="font-mono text-xs tracking-widest text-accent uppercase"
      aria-hidden="true"
    >
      &rarr;
    </span>
    <h2 class="font-display text-xl font-bold text-foreground sm:text-2xl">
      {t("diagnosis.title", lang)}
    </h2>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-foreground/75 sm:text-base">
    {t("diagnosis.desc", lang)}
  </p>
  <a
    href={ctaUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="link-underline-slide group mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent"
  >
    {t("diagnosis.cta", lang)}
    <span
      aria-hidden="true"
      class="transition-transform duration-150 group-hover:translate-x-0.5"
    >
      &rarr;
    </span>
  </a>
</div>
