---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { SIGNATURES } from "@/data/signatures";
import { SITE } from "@/config";
import { getListedPosts } from "@/utils/getSortedPosts";
import { filterByLang } from "@/utils/i18n";
import { getPath } from "@/utils/getPath";

const RELATED_LIMIT = 5;

const posts = await getCollection("blog");
const listed = filterByLang(getListedPosts(posts), "zh").filter(
  ({ data }) => !data.hideFromHome
);

const groups = SIGNATURES.map(entry => {
  const matches = listed.filter(({ data }) => data.signature === entry.id);
  return {
    entry,
    featured: matches[0],
    related: matches.slice(1, 1 + RELATED_LIMIT),
  };
});

const linkClass =
  "mt-1 block font-display leading-snug font-bold text-foreground transition-colors duration-150 hover:text-accent focus-visible:ring-1 focus-visible:ring-accent focus-visible:outline-none";
---

<Layout
  language="zh"
  title={`我做的東西 | ${SITE.title}`}
  description="我做的東西"
>
  <Header />
  <main id="main-content" class="app-layout pb-16">
    <h1
      class="pt-16 font-display text-4xl leading-tight font-black tracking-tight text-foreground sm:text-6xl"
    >
      我做的東西
    </h1>
    {
      groups.map(({ entry, featured, related }) => (
        <section id={`sig-${entry.id}`} class="border-b border-border py-8">
          <h2 class="font-display text-2xl leading-snug font-bold text-foreground sm:text-3xl">
            {entry.name}
          </h2>
          {entry.oneLiner && (
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-foreground/75 sm:text-base">
              {entry.oneLiner}
            </p>
          )}
          {featured && (
            <div class="mt-6">
              <p class="text-xs font-semibold tracking-widest text-foreground/50 uppercase">
                代表文章
              </p>
              <Datetime
                pubDatetime={featured.data.pubDatetime}
                modDatetime={featured.data.modDatetime}
                timezone={featured.data.timezone}
                class="mt-3 text-sm text-foreground/60"
              />
              <a
                href={getPath(featured.id, featured.filePath)}
                class:list={[linkClass, "text-xl sm:text-2xl"]}
              >
                {featured.data.title}
              </a>
            </div>
          )}
          {related.length > 0 && (
            <div class="mt-6">
              <p class="text-xs font-semibold tracking-widest text-foreground/50 uppercase">
                相關文章
              </p>
              <ul class="list-none">
                {related.map(post => (
                  <li class="border-b border-border py-4">
                    <Datetime
                      pubDatetime={post.data.pubDatetime}
                      modDatetime={post.data.modDatetime}
                      timezone={post.data.timezone}
                      class="text-sm text-foreground/60"
                    />
                    <a
                      href={getPath(post.id, post.filePath)}
                      class:list={[linkClass, "text-lg"]}
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
