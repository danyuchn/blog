---
import PostList from "@/components/PostList.astro";
import { postListPaths } from "@/utils/listRoutes";

export async function getStaticPaths({
  paginate,
}: {
  paginate: Parameters<typeof postListPaths>[0];
}) {
  return postListPaths(paginate, "zh");
}

const { page, otherPageCount } = Astro.props;
---

<PostList lang="zh" page={page} otherPageCount={otherPageCount} />
