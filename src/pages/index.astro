---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import GridCard from "@/components/GridCard.astro";
import { getListedPosts } from "@/utils/getSortedPosts";
import { filterByLang } from "@/utils/i18n";
import { t } from "@/i18n/ui";
import { withBase } from "@/utils/withBase";

const RECENT_COUNT = 6;

const posts = await getCollection("blog");

const sortedPosts = getListedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
// 雙語各取最新 N 篇再合併渲染（LangSwitcher 以 display:none 過濾另一語言）。
// 不可在 zh/en 混合陣列上 slice——每語言可見篇數會不可控。
const recentPosts = (["zh", "en"] as const).flatMap(lang =>
  filterByLang(sortedPosts, lang)
    .filter(({ data }) => !data.featured)
    .slice(0, RECENT_COUNT)
);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-16 pb-6">
      <h1
        class="font-display text-4xl leading-tight font-black tracking-tight text-foreground sm:text-6xl"
        data-lang="zh"
      >
        {t("home.hello", "zh")}
      </h1>
      <h1
        class="font-display text-4xl leading-tight font-black tracking-tight text-foreground sm:text-6xl"
        data-lang="en"
      >
        {t("home.hello", "en")}
      </h1>

      <div class="mt-6 max-w-3xl">
        <p class="text-base leading-relaxed text-foreground/80" data-lang="zh">
          {t("home.credibility", "zh")}
        </p>
        <ul
          class="mt-4 grid grid-cols-3 gap-2"
          data-lang="zh"
        >
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact1", "zh")}
          </li>
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact2", "zh")}
          </li>
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact3", "zh")}
          </li>
        </ul>
        <p class="text-base leading-relaxed text-foreground/80" data-lang="en">
          {t("home.credibility", "en")}
        </p>
        <ul class="mt-4 grid grid-cols-3 gap-2" data-lang="en">
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact1", "en")}
          </li>
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact2", "en")}
          </li>
          <li class="border border-border px-2 py-2 text-xs leading-snug text-foreground sm:text-sm">
            {t("home.fact3", "en")}
          </li>
        </ul>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-8 pb-8",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <p class="mb-6 text-sm font-semibold tracking-widest text-accent uppercase">
            精選
          </p>
          <ul class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
            {featuredPosts.map(post => (
              <GridCard {...post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-4">
          <p class="mb-2 text-sm font-semibold tracking-widest text-foreground/50 uppercase">
            最近在寫
          </p>
          <ul>
            {recentPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="py-8">
      <LinkButton
        href={withBase("/posts/")}
        class="text-sm text-foreground/50 transition-colors hover:text-accent"
      >
        所有文章 →
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", window.location.pathname);
    }
  });
</script>
